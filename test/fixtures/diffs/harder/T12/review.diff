diff --git a/services/client/src/pages/_components/Post/Repost.tsx b/services/client/src/pages/_components/Post/Repost.tsx
new file mode 100644
index 0000000..af2661b
--- /dev/null
+++ b/services/client/src/pages/_components/Post/Repost.tsx
@@ -0,0 +1,37 @@
+import { Repeat2 } from 'lucide-react';
+
+import { Button } from '@cc/components/Button';
+import { useSession } from '@cc/hooks/use-session';
+import { type RouterOutputs, t } from '@cc/lib/trpc';
+
+type InfinitePost = RouterOutputs['post']['infinite']['posts'][0];
+
+interface RepostProps {
+  row: InfinitePost;
+}
+
+export default function Repost({ row }: RepostProps) {
+  const { user } = useSession();
+  const tUtils = t.useUtils();
+
+  const repostMutation = t.post.repost.useMutation({
+    onSuccess: async () => {
+      await tUtils.post.infinite.invalidate({});
+    },
+  });
+
+  return (
+    <>
+      <Button
+        variant="ghost"
+        size="icon"
+        aria-label="repost"
+        onClick={() => repostMutation.mutate({ postId: row.id })}
+        disabled={!user}
+      >
+        <Repeat2 />
+      </Button>
+      <p>{row.reposts}</p>
+    </>
+  );
+}
