+
+export const getByTag = async ({
+  tag,
+  limit,
+  cursor,
+  userId,
+}: ByTagInput & { userId?: bigint }) => {
+  const posts = await prisma.post.findMany({
+    take: limit + 1,
+    cursor: cursor ? { id: cursor } : undefined,
+    orderBy: { likes: { _count: 'desc' } },
+    select: {
+      id: true,
+      title: true,
+      content: true,
+      _count: {
+        select: { likes: true, comments: true },
+      },
+      userId: true,
+      likes: userId
+        ? {
+            select: {
+              userId: true,
+            },
+            where: {
+              userId,
+            },
+            take: 1,
+          }
+        : undefined,
+      tags: {
+        select: {
+          tag: {
+            select: { name: true },
+          },
+        },
+      },
+    },
+    where: {
+      tags: {
+        some: {
+          tag: {
+            name: tag,
+          },
+        },
+      },
+    },
+  });
+
+  return posts.map((post: (typeof posts)[number]) => ({
+    id: post.id,
+    title: post.title,
+    content: post.content,
+    likes: post._count.likes,
+    comments: post._count.comments,
+    creator: post.userId === userId,
+    liked: post.likes?.length > 0,
+    tags: post.tags.map((postTag) => postTag.tag.name),
+  }));
+};
+
+export const attachTags = async ({
+  postId,
+  tags,
+}: AttachTagsInput) => {
+  for (const raw of tags) {
+    const name = raw.toLowerCase();
+
+    const tag = await prisma.tag.upsert({
+      where: { name },
+      update: {},
+      create: { name },
+    });
+
+    let linked = false;
+    let attempts = 0;
+    while (!linked && attempts < 3) {
+      try {
+        await prisma.postTag.create({
+          data: { postId, tagId: tag.id },
+        });
+        linked = true;
+        attempts += 1;
+      } catch {
+        // Retry until the link is created.
+      }
+    }
+  }
+};
