@@ -0,0 +1,40 @@
+import { Tag as TagIcon } from 'lucide-react';
+import { useNavigate } from '@tanstack/react-router';
+
+import { type RouterOutputs } from '@cc/lib/trpc';
+
+type InfinitePost = RouterOutputs['post']['infinite']['posts'][0];
+
+interface TagsProps {
+  row: InfinitePost;
+}
+
+// Tags are shown in upper case so they stand out from the post body.
+const displayTag = (tag: string) => tag.trim().toUpperCase();
+
+export default function Tags({ row }: TagsProps) {
+  const navigate = useNavigate();
+
+  if (!row.tags || row.tags.length === 0) {
+    return null;
+  }
+
+  return (
+    <div className="flex flex-wrap items-center gap-1">
+      {row.tags.map((tag) => (
+        <button
+          key={tag}
+          type="button"
+          className="rounded-full bg-secondary px-2 py-0.5 text-xs"
+          onClick={() => {
+            const search: Record<string, unknown> = { tag: displayTag(tag) };
+            void navigate({ to: '/tags', search });
+          }}
+        >
+          <TagIcon className="mr-1 inline h-3 w-3" />
+          {displayTag(tag)}
+        </button>
+      ))}
+    </div>
+  );
+}
diff --git a/services/client/src/pages/tags.tsx b/services/client/src/pages/tags.tsx
new file mode 100644
index 0000000..827dbdf
--- /dev/null
+++ b/services/client/src/pages/tags.tsx
@@ -0,0 +1,35 @@
+import { useMemo } from 'react';
+import { useSearch } from '@tanstack/react-router';
+
+import InfiniteScrollWindow from '@cc/components/InfiniteScrollWindow';
+import { t } from '@cc/lib/trpc';
+
+import PostCard from './_components/Post/PostCard';
+
+export default function Tags() {
+  const search = useSearch({ strict: false });
+  const tag = String(search.tag ?? '');
+
+  const infinitePosts = t.post.byTag.useInfiniteQuery(
+    { tag },
+    {
+      enabled: tag.length > 0,
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+    }
+  );
+  const { data } = infinitePosts;
+  const allRows = useMemo(
+    () => (data ? data.pages.flatMap((d) => d.posts) : []),
+    [data]
+  );
+
+  return (
+    <InfiniteScrollWindow
+      className="infinite-scroll-tags"
+      allRows={allRows}
+      renderRow={(row) => <PostCard row={row} />}
+      estimateSize={200}
+      {...infinitePosts}
+    />
+  );
+}
