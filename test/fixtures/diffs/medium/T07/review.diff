@@ -0,0 +1,55 @@
+import { useEffect, useMemo, useState } from 'react';
+
+import InfiniteScrollWindow from '@cc/components/InfiniteScrollWindow';
+import { Input } from '@cc/components/Input';
+import { t } from '@cc/lib/trpc';
+
+export default function Search() {
+  const [query, setQuery] = useState('');
+  const [debouncedQuery, setDebouncedQuery] = useState('');
+
+  useEffect(() => {
+    const timer = setTimeout(() => setDebouncedQuery(query), 300);
+    return () => clearTimeout(timer);
+  }, [query]);
+
+  const infiniteSearch = t.post.search.useInfiniteQuery(
+    { query: debouncedQuery },
+    {
+      enabled: debouncedQuery.length > 0,
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+    }
+  );
+  const { data } = infiniteSearch;
+  const allRows = useMemo(
+    () => (data ? data.pages.flatMap((d) => d.posts) : []),
+    [data]
+  );
+
+  return (
+    <div className="flex flex-col gap-2">
+      <Input
+        placeholder="Search posts by title"
+        value={query}
+        onChange={(event) => setQuery(event.target.value)}
+      />
+      <p className="text-sm text-muted-foreground">
+        {data?.pages[0]?.total ?? 0} results
+      </p>
+      <InfiniteScrollWindow
+        className="infinite-scroll-search"
+        allRows={allRows}
+        renderRow={(row) => (
+          <div className="rounded border p-2">
+            <p className="font-medium">{row.title}</p>
+            <p className="text-sm text-muted-foreground">
+              {row.likes} likes by user {row.creator.toString()}
+            </p>
+          </div>
+        )}
+        estimateSize={200}
+        {...infiniteSearch}
+      />
+    </div>
+  );
+}
