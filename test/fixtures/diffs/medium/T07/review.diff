+import { useMemo } from 'react';
+
+import InfiniteScrollWindow from '@cc/components/InfiniteScrollWindow';
+import { t } from '@cc/lib/trpc';
+
+export default function Trending() {
+  const infiniteTrending = t.post.trending.useInfiniteQuery(
+    {},
+    {
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+    }
+  );
+  const { data } = infiniteTrending;
+  const allRows = useMemo(
+    () => (data ? data.pages.flatMap((d) => d.posts) : []),
+    [data]
+  );
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h2 className="text-xl font-bold">Trending posts</h2>
+      <InfiniteScrollWindow
+        className="infinite-scroll-trending"
+        allRows={allRows}
+        renderRow={(row) => (
+          <div className="rounded border p-2">
+            <p className="font-medium">{row.title}</p>
+            <p className="text-sm text-muted-foreground">
+              {row.likes} likes{row.creator ? ' (yours)' : ''}
+            </p>
+          </div>
+        )}
+        estimateSize={200}
+        {...infiniteTrending}
+      />
+    </div>
+  );
+}
