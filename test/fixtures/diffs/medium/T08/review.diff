@@ -0,0 +1,12 @@
+// Trims the overflow row from a cursor page and returns its id as the next
+// cursor. Shared by the post and comment infinite routes.
+export const popNextCursor = <T extends { id: bigint }>(
+  rows: T[],
+  limit: number
+): bigint | undefined => {
+  if (rows.length >= limit) {
+    const nextItem = rows.pop();
+    return nextItem?.id;
+  }
+  return undefined;
+};
