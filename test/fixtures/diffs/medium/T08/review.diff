diff --git a/services/client/src/core/hooks/use-infinite-list.ts b/services/client/src/core/hooks/use-infinite-list.ts
new file mode 100644
index 0000000..ec5efd5
--- /dev/null
+++ b/services/client/src/core/hooks/use-infinite-list.ts
@@ -0,0 +1,34 @@
+import { useMemo } from 'react';
+
+interface InfinitePage<TRow> {
+  nextCursor?: bigint | null;
+  posts?: TRow[];
+  comments?: TRow[];
+}
+
+interface InfiniteData<TRow> {
+  pages: InfinitePage<TRow>[];
+}
+
+type RowKey = 'posts' | 'comments';
+
+// Shared options for every infinite list in the app. The lists all page
+// forward through the same cursor, so the options can live in one place.
+export const infiniteListOptions = {
+  getNextPageParam: <TPage extends { nextCursor?: bigint | null }>(
+    lastPage: TPage
+  ) => lastPage.nextCursor ?? undefined,
+};
+
+// Flattens the pages of an infinite query into a single row array.
+export const useInfiniteList = <TRow>(
+  data: InfiniteData<TRow> | undefined,
+  rowKey: RowKey
+) => {
+  const allRows = useMemo(
+    () => (data ? data.pages.flatMap((page) => page[rowKey] ?? []) : []),
+    [data, rowKey]
+  );
+
+  return { allRows };
+};
diff --git a/services/client/src/core/hooks/use-infinite-scroll-trigger.ts b/services/client/src/core/hooks/use-infinite-scroll-trigger.ts
new file mode 100644
index 0000000..5188dbd
--- /dev/null
+++ b/services/client/src/core/hooks/use-infinite-scroll-trigger.ts
@@ -0,0 +1,36 @@
+import { useEffect } from 'react';
+
+interface VirtualItem {
+  index: number;
+}
+
+// Fetches the next page once the last virtualized row becomes visible.
+export const useInfiniteScrollTrigger = (
+  virtualItems: VirtualItem[],
+  allRowsLength: number,
+  hasNextPage: boolean,
+  isFetchingNextPage: boolean,
+  fetchNextPage: () => Promise<unknown>
+) => {
+  useEffect(() => {
+    const [lastItem] = [...virtualItems].reverse();
+
+    if (!lastItem) {
+      return;
+    }
+
+    if (
+      lastItem.index >= allRowsLength - 1 &&
+      hasNextPage &&
+      !isFetchingNextPage
+    ) {
+      void fetchNextPage();
+    }
+  }, [
+    hasNextPage,
+    fetchNextPage,
+    allRowsLength,
+    isFetchingNextPage,
+    virtualItems,
+  ]);
+};
diff --git a/services/client/src/core/utils/infinite-cache.ts b/services/client/src/core/utils/infinite-cache.ts
new file mode 100644
index 0000000..9d8e0c3
--- /dev/null
+++ b/services/client/src/core/utils/infinite-cache.ts
@@ -0,0 +1,42 @@
+import { produce } from 'immer';
+
+import type { UnparsedDefaultId } from '@shared/zod/common';
+
+import { compareEqual, compareLessThan } from '@cc/utils/bigint';
+
+interface InfinitePage<TRow> {
+  nextCursor?: UnparsedDefaultId | null;
+  posts?: TRow[];
+  comments?: TRow[];
+}
+
+interface InfiniteData<TRow> {
+  pages: InfinitePage<TRow>[];
+}
+
+type RowKey = 'posts' | 'comments';
+
+// Applies a mutation to the cached row with the given id. Every list mutation
+// used to repeat the same produce/compare loop, so it now lives here.
+export const updateInfiniteCache = <TRow extends { id: UnparsedDefaultId }>(
+  data: InfiniteData<TRow> | undefined,
+  rowKey: RowKey,
+  id: UnparsedDefaultId,
+  mutate: (draft: any) => void
+) => {
+  return !data
+    ? data
+    : produce(data, (draft) => {
+        for (const page of draft.pages) {
+          if (compareLessThan(page.nextCursor!, id)) {
+            for (const row of page[rowKey] ?? []) {
+              if (compareEqual(row.id, id)) {
+                mutate(row);
+                break;
+              }
+            }
+            break;
+          }
+        }
+      });
+};
