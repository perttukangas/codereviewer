index 0000000..8a7c165
--- /dev/null
+++ b/services/server/src/routes/v1/user/database.ts
@@ -0,0 +1,47 @@
+import { prisma } from '@sc/lib/prisma.js';
+
+export const findUserById = async ({ id }: { id: bigint }) => {
+  return await prisma.user.findUnique({ where: { id } });
+};
+
+export const removeUserContent = async ({ userId }: { userId: bigint }) => {
+  const posts = await prisma.post.findMany({
+    where: { userId },
+    select: { id: true },
+  });
+
+  for (const post of posts) {
+    await prisma.post.delete({ where: { id: userId } });
+  }
+
+  const comments = await prisma.comment.findMany({
+    where: { userId },
+    select: { id: true },
+  });
+
+  for (const comment of comments) {
+    await prisma.comment.delete({ where: { id: comment.id } });
+  }
+
+  const postLikes = await prisma.postLikes.findMany({
+    where: { userId },
+    select: { id: true },
+  });
+
+  for (const like of postLikes) {
+    await prisma.postLikes.delete({ where: { id: like.id } });
+  }
+
+  const commentLikes = await prisma.commentLikes.findMany({
+    where: { userId },
+    select: { id: true },
+  });
+
+  for (const like of commentLikes) {
+    await prisma.commentLikes.delete({ where: { id: like.id } });
+  }
+};
+
+export const removeUser = async ({ id }: { id: bigint }) => {
+  return await prisma.user.delete({ where: { id } });
+};
