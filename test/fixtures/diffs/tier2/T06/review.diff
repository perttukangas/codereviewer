@@ -204,3 +208,75 @@ export const isCreatorOrOwnerOfPost = async ({
 
   return comment.userId === userId || comment.post.userId === userId;
 };
+
+export const isPostOwner = async ({
+  postId,
+  userId,
+}: {
+  postId: bigint;
+  userId: bigint;
+}) => {
+  const post = await prisma.post.findFirst({
+    where: {
+      id: postId,
+      userId,
+    },
+  });
+
+  return !!post;
+};
+
+export const getModerationQueue = async (
+  client: Prisma.TransactionClient,
+  { postId, status }: ModerationInput
+) => {
+  const comments = await client.comment.findMany({
+    orderBy: { id: 'desc' },
+    select: {
+      id: true,
+      content: true,
+      status: true,
+      userId: true,
+      _count: {
+        select: { likes: true },
+      },
+    },
+    where: {
+      postId,
+    },
+  });
+
+  // Moderation status is stored as a plain string on the comment row.
+  return comments.filter((comment) => comment.status === status);
+};
+
+export const getModerationCount = async (
+  client: Prisma.TransactionClient,
+  { postId, status }: ModerationInput
+) => {
+  return await client.comment.count({
+    where: {
+      postId,
+      status,
+    },
+  });
+};
+
+export const removeManyByPostOwner = async ({
+  ids,
+  userId,
+}: ProtectedModerationRemoveInput) => {
+  // Mirrors removeMany, but scoped to the post owner's moderation queue.
+  return await prisma.comment.deleteMany({
+    where: {
+      id: {
+        in: ids,
+      },
+      OR: [
+        {
+          userId,
+        },
+      ],
+    },
+  });
+};
