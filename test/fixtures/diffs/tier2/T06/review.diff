@@ -0,0 +1,88 @@
+import { useState } from 'react';
+
+import { Button } from '@cc/components/Button';
+import { useToast } from '@cc/hooks/use-toast';
+import { type RouterOutputs, t } from '@cc/lib/trpc';
+
+type InfinitePost = RouterOutputs['post']['infiniteCreator']['posts'][0];
+
+interface ModerationProps {
+  post: InfinitePost;
+}
+
+const statuses = ['pending', 'approved', 'rejected'];
+
+export default function Moderation({ post }: ModerationProps) {
+  const { toast } = useToast();
+  const tUtils = t.useUtils();
+  const [status, setStatus] = useState('pending');
+  const [selected, setSelected] = useState<string[]>([]);
+
+  const queue = t.post.comment.moderationQueue.useQuery({
+    postId: post.id,
+    status,
+  });
+
+  const removeManyMutation = t.post.comment.moderationRemoveMany.useMutation({
+    onSuccess: async () => {
+      await tUtils.post.comment.moderationQueue.invalidate({ postId: post.id });
+      setSelected([]);
+      toast({ description: 'Moderation queue updated' });
+    },
+  });
+
+  const toggle = (id: string) => {
+    setSelected((current) =>
+      current.includes(id)
+        ? current.filter((item) => item !== id)
+        : [...current, id]
+    );
+  };
+
+  return (
+    <div className="flex flex-col gap-2 p-2">
+      <div className="flex items-center justify-between">
+        <h2 className="text-lg font-semibold">
+          Moderation queue ({queue.data?.total ?? 0})
+        </h2>
+        <div className="flex gap-1">
+          {statuses.map((value) => (
+            <Button
+              key={value}
+              variant={value === status ? 'default' : 'outline'}
+              size="sm"
+              onClick={() => setStatus(value)}
+            >
+              {value}
+            </Button>
+          ))}
+        </div>
+      </div>
+      {queue.data?.comments.map((comment) => (
+        <label
+          key={comment.id.toString()}
+          className="flex items-center gap-2 rounded border p-2"
+        >
+          <input
+            type="checkbox"
+            checked={selected.includes(comment.id.toString())}
+            onChange={() => toggle(comment.id.toString())}
+          />
+          <span>{comment.content}</span>
+        </label>
+      ))}
+      <Button
+        variant="destructive"
+        disabled={selected.length === 0}
+        onClick={() =>
+          removeManyMutation.mutate({
+            postId: post.id,
+            ids: selected,
+          })
+        }
+      >
+        Remove selected
+      </Button>
+    </div>
+  );
+}
