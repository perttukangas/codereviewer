+import { useMemo } from 'react';
+
+import InfiniteScrollWindow from '@cc/components/InfiniteScrollWindow';
+import { t } from '@cc/lib/trpc';
+
+import PostCard from '../Post/PostCard';
+
+export default function Bookmarks() {
+  const infiniteBookmarks = t.post.bookmarks.useInfiniteQuery(
+    {},
+    {
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+    }
+  );
+  const { data } = infiniteBookmarks;
+  const allRows = useMemo(
+    () => (data ? data.pages.flatMap((d) => d.posts) : []),
+    [data]
+  );
+
+  return (
+    <InfiniteScrollWindow
+      className="infinite-scroll-bookmarks"
+      allRows={allRows}
+      renderRow={(row) => <PostCard row={row} />}
+      estimateSize={200}
+      {...infiniteBookmarks}
+    />
+  );
+}
