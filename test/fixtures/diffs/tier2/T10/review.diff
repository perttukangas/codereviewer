diff --git a/services/client/src/pages/_components/Post/Bookmark.tsx b/services/client/src/pages/_components/Post/Bookmark.tsx
new file mode 100644
index 0000000..e00ef11
--- /dev/null
+++ b/services/client/src/pages/_components/Post/Bookmark.tsx
@@ -0,0 +1,58 @@
+import { Bookmark as BookmarkIcon } from 'lucide-react';
+import { useRef, useState } from 'react';
+
+import { Button } from '@cc/components/Button';
+import { useSession } from '@cc/hooks/use-session';
+import { type RouterOutputs, t } from '@cc/lib/trpc';
+
+type InfinitePost = RouterOutputs['post']['infinite']['posts'][0];
+
+interface BookmarkProps {
+  row: InfinitePost;
+}
+
+export default function Bookmark({ row }: BookmarkProps) {
+  const tUtils = t.useUtils();
+  const { user } = useSession();
+  const [bookmarked, setBookmarked] = useState(row.bookmarked);
+  const [bookmarkId, setBookmarkId] = useState(row.bookmarkId);
+  const timerRef = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+
+  const bookmarkMutation = t.post.bookmark.useMutation({
+    onSuccess: (data) => {
+      setBookmarkId(data.id);
+    },
+  });
+
+  const unbookmarkMutation = t.post.unbookmark.useMutation();
+
+  const toggle = () => {
+    const next = !bookmarked;
+    setBookmarked(next);
+
+    // Debounce the request so rapid clicks only send the final state.
+    timerRef.current = setTimeout(() => {
+      if (next) {
+        bookmarkMutation.mutate({ id: row.id });
+      } else if (bookmarkId) {
+        unbookmarkMutation.mutate({ bookmarkId });
+      }
+      void tUtils.post.infinite.invalidate({});
+    }, 300);
+  };
+
+  return (
+    <>
+      <Button
+        variant="ghost"
+        size="icon"
+        aria-label="bookmark-post"
+        onClick={toggle}
+        disabled={!user}
+      >
+        <BookmarkIcon className={bookmarked ? 'fill-primary' : ''} />
+      </Button>
+      <p>{row.bookmarks}</p>
+    </>
+  );
+}
