diff --git a/services/server/src/routes/v1/post/export.ts b/services/server/src/routes/v1/post/export.ts
new file mode 100644
index 0000000..cb672d7
--- /dev/null
+++ b/services/server/src/routes/v1/post/export.ts
@@ -0,0 +1,25 @@
+interface ExportRow {
+  id: bigint;
+  title: string;
+  content: string;
+  comments: number;
+}
+
+const escapeField = (value: string) => {
+  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
+    return `"${value.replace(/"/g, '""')}"`;
+  }
+  return value;
+};
+
+export const toCsv = (rows: ExportRow[]) => {
+  const header = ['id', 'title', 'content', 'comments'].join(',');
+
+  const lines = rows.map((row) =>
+    [row.id, row.comments, row.title, row.content]
+      .map((value) => escapeField(String(value)))
+      .join(',')
+  );
+
+  return [header, ...lines].join('\n');
+};
