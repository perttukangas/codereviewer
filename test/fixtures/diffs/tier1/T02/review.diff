@@ -0,0 +1,51 @@
+import { Download } from 'lucide-react';
+
+import { Button } from '@cc/components/Button';
+import { useSession } from '@cc/hooks/use-session';
+import { useToast } from '@cc/hooks/use-toast';
+import { t } from '@cc/lib/trpc';
+
+export default function Export() {
+  const { user } = useSession();
+  const { toast } = useToast();
+
+  const exportQuery = t.post.export.useQuery(
+    { userId: user?.id ?? '' },
+    { enabled: false }
+  );
+
+  const handleExport = async () => {
+    try {
+      const { data } = await exportQuery.refetch();
+      if (!data) {
+        return;
+      }
+
+      const blob = new Blob([data], { type: 'text/csv' });
+      const url = URL.createObjectURL(blob);
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = 'my-posts.csv';
+      link.click();
+      link.remove();
+      URL.revokeObjectURL(url);
+    } catch {
+      toast({
+        variant: 'destructive',
+        description: 'Failed to export posts',
+      });
+    }
+  };
+
+  return (
+    <Button
+      variant="outline"
+      size="sm"
+      disabled={!user || exportQuery.isFetching}
+      onClick={() => void handleExport()}
+    >
+      <Download />
+      Export
+    </Button>
+  );
+}
