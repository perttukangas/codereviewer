@@ -0,0 +1,69 @@
+import { zodResolver } from '@hookform/resolvers/zod';
+import { useForm } from 'react-hook-form';
+
+import { type ChangeEmailInput, changeEmailInput } from '@shared/zod/user';
+
+import { Button } from '@cc/components/Button';
+import {
+  Form,
+  FormControl,
+  FormField,
+  FormItem,
+  FormLabel,
+  FormMessage,
+} from '@cc/components/Form';
+import { Input } from '@cc/components/Input';
+import { useToast } from '@cc/hooks/use-toast';
+import { t } from '@cc/lib/trpc';
+
+export default function EmailForm() {
+  const { toast } = useToast();
+
+  const form = useForm<ChangeEmailInput>({
+    resolver: zodResolver(changeEmailInput),
+    defaultValues: { email: '' },
+  });
+
+  const changeEmail = t.user.changeEmail.useMutation({
+    onSuccess: () => {
+      form.reset();
+      toast({ description: 'Email updated' });
+    },
+    onError: (error) => {
+      toast({ variant: 'destructive', description: error.message });
+    },
+  });
+
+  return (
+    <Form {...form}>
+      <form
+        className="flex flex-col gap-2"
+        onSubmit={(event) => {
+          event.preventDefault();
+          void form.handleSubmit((data) => changeEmail.mutate(data))(event);
+        }}
+      >
+        <FormField
+          control={form.control}
+          name="email"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>Email</FormLabel>
+              <FormControl>
+                <Input type="email" placeholder="Email" {...field} />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+        <Button
+          className="self-start"
+          type="submit"
+          disabled={form.formState.isSubmitting}
+        >
+          Save email
+        </Button>
+      </form>
+    </Form>
+  );
+}
