diff --git a/services/server/src/routes/v1/post/scheduler.ts b/services/server/src/routes/v1/post/scheduler.ts
new file mode 100644
index 0000000..ba6acfa
--- /dev/null
+++ b/services/server/src/routes/v1/post/scheduler.ts
@@ -0,0 +1,46 @@
+import { prisma } from '@sc/lib/prisma.js';
+import { info } from '@sc/utils/logger.js';
+
+import { findDueDrafts, markDraftsPublished } from './database.js';
+
+const PUBLISH_INTERVAL_MS = 60_000;
+
+const notifyAuthor = async (userId: bigint, title: string) => {
+  info(`Scheduled post "${title}" for user ${userId} is now live`);
+};
+
+export const runPublishTick = async () => {
+  const now = new Date();
+  const due = await findDueDrafts(now);
+
+  if (due.length === 0) {
+    return;
+  }
+
+  await markDraftsPublished(due.map((post) => post.id));
+
+  // Read the rows back so we can notify each author.
+  const published = await prisma.post.findMany({
+    where: { publishedAt: { gte: now } },
+    select: { id: true, userId: true, title: true },
+  });
+
+  for (const post of published) {
+    await notifyAuthor(post.userId, post.title);
+  }
+};
+
+let timer: NodeJS.Timeout | undefined;
+
+export const startScheduler = () => {
+  timer = setInterval(async () => {
+    await runPublishTick();
+  }, PUBLISH_INTERVAL_MS);
+};
+
+export const stopScheduler = () => {
+  if (timer) {
+    clearInterval(timer);
+    timer = undefined;
+  }
+};
