diff --git a/services/server/src/routes/v1/post/purge.ts b/services/server/src/routes/v1/post/purge.ts
new file mode 100644
index 0000000..1d6479d
--- /dev/null
+++ b/services/server/src/routes/v1/post/purge.ts
@@ -0,0 +1,34 @@
+import { prisma } from '@sc/lib/prisma.js';
+
+const RETENTION_DAYS = 30;
+
+/**
+ * Permanently remove posts that have been soft-deleted for longer than the
+ * retention window. Runs on a schedule from the server entrypoint.
+ */
+export const purgeExpiredPosts = async () => {
+  const cutoff = new Date(
+    Date.now() - RETENTION_DAYS * 24 * 60 * 60 * 1000
+  );
+
+  const expired = await prisma.post.findMany({
+    where: {
+      deletedAt: { lt: cutoff },
+    },
+    select: { id: true },
+  });
+
+  if (expired.length === 0) {
+    return 0;
+  }
+
+  const ids = expired.map((post) => post.id);
+
+  const removed = await prisma.post.deleteMany({
+    where: {
+      id: { in: ids },
+    },
+  });
+
+  return removed.count;
+};
