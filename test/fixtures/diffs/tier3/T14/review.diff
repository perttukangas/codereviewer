+++ b/services/client/src/pages/_components/Post/Moderation.tsx
@@ -0,0 +1,26 @@
+import { lazy } from 'react';
+
+import { t } from '@cc/lib/trpc';
+
+const ModerationCard = lazy(() => import('./ModerationCard'));
+
+export default function Moderation() {
+  const queue = t.post.moderationQueue.useInfiniteQuery(
+    {},
+    {
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+    }
+  );
+
+  const posts = queue.data?.pages.flatMap((page) => page.posts) ?? [];
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h2 className="text-lg font-semibold">Moderation queue</h2>
+      {posts.length === 0 && <p>No posts awaiting moderation.</p>}
+      {posts.map((post) => (
+        <ModerationCard key={post.id.toString()} post={post} />
+      ))}
+    </div>
+  );
+}
