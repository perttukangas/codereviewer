+import { type RouterOutputs } from '@cc/lib/trpc';
+
+type QueuePost = RouterOutputs['post']['moderationQueue']['posts'][0];
+
+interface ModerationCardProps {
+  post: QueuePost;
+}
+
+export default function ModerationCard({ post }: ModerationCardProps) {
+  return (
+    <Card className="rounded-none">
+      <CardHeader>
+        <CardTitle>{post.title}</CardTitle>
+      </CardHeader>
+    </Card>
+  );
+}
