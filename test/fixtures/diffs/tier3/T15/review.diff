diff --git a/services/server/src/routes/v1/webhook/database.ts b/services/server/src/routes/v1/webhook/database.ts
new file mode 100644
index 0000000..a35d275
--- /dev/null
+++ b/services/server/src/routes/v1/webhook/database.ts
@@ -0,0 +1,96 @@
+import { randomBytes } from 'node:crypto';
+
+import {
+  ProtectedRemoveWebhookInput,
+  ProtectedWebhookInput,
+  WebhookEvent,
+} from '@shared/zod/webhook.js';
+
+import { prisma } from '@sc/lib/prisma.js';
+
+export const createWebhook = async ({
+  url,
+  event,
+  userId,
+}: ProtectedWebhookInput) => {
+  return await prisma.webhook.create({
+    data: {
+      url,
+      event,
+      userId,
+      secret: randomBytes(24).toString('hex'),
+    },
+  });
+};
+
+export const removeWebhook = async ({
+  id,
+  userId,
+}: ProtectedRemoveWebhookInput) => {
+  return await prisma.webhook.deleteMany({
+    where: {
+      id,
+      userId,
+    },
+  });
+};
+
+export const listWebhooks = async (userId: bigint) => {
+  return await prisma.webhook.findMany({
+    where: { userId },
+    orderBy: { id: 'desc' },
+  });
+};
+
+export const enqueueDelivery = async ({
+  event,
+  postId,
+  title,
+  userId,
+}: {
+  event: WebhookEvent;
+  postId: bigint;
+  title: string;
+  userId: bigint;
+}) => {
+  const webhooks = await prisma.webhook.findMany({
+    where: { userId, event, active: true },
+  });
+
+  if (webhooks.length === 0) {
+    return;
+  }
+
+  // Build the payload once per subscriber so the delivery row is self-contained.
+  const payload = {
+    event,
+    postId,
+    title,
+    occurredAt: new Date().toISOString(),
+  };
+
+  await prisma.webhookDelivery.createMany({
+    data: webhooks.map((webhook) => ({
+      webhookId: webhook.id,
+      event,
+      postId,
+      title,
+      payload,
+    })),
+  });
+};
+
+export const listPendingDeliveries = async () => {
+  return await prisma.webhookDelivery.findMany({
+    where: { status: 'pending' },
+    orderBy: { id: 'asc' },
+    include: { webhook: true },
+  });
+};
+
+export const markDeliveryDelivered = async (id: bigint) => {
+  return await prisma.webhookDelivery.update({
+    where: { id },
+    data: { status: 'delivered' },
+  });
+};
diff --git a/services/server/src/routes/v1/webhook/index.ts b/services/server/src/routes/v1/webhook/index.ts
new file mode 100644
index 0000000..54e6f16
