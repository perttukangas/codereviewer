@@ -0,0 +1,89 @@
+import { useState } from 'react';
+
+import { webhookEventValues } from '@shared/zod/webhook';
+
+import { Button } from '@cc/components/Button';
+import { Card, CardContent, CardHeader, CardTitle } from '@cc/components/Card';
+import { Input } from '@cc/components/Input';
+import { useToast } from '@cc/hooks/use-toast';
+import { t } from '@cc/lib/trpc';
+
+export default function Settings() {
+  const { toast } = useToast();
+  const tUtils = t.useUtils();
+  const [url, setUrl] = useState('');
+  const [event, setEvent] = useState<(typeof webhookEventValues)[number]>(
+    webhookEventValues[0]
+  );
+
+  const webhooks = t.webhook.list.useQuery();
+
+  const createMutation = t.webhook.create.useMutation({
+    onSuccess: async () => {
+      setUrl('');
+      await tUtils.webhook.list.invalidate();
+      toast({ description: 'Webhook added.' });
+    },
+  });
+
+  const removeMutation = t.webhook.remove.useMutation({
+    onSuccess: async () => {
+      await tUtils.webhook.list.invalidate();
+      toast({ description: 'Webhook removed.' });
+    },
+  });
+
+  return (
+    <Card className="rounded-none">
+      <CardHeader>
+        <CardTitle>Webhooks</CardTitle>
+      </CardHeader>
+      <CardContent className="flex flex-col gap-3">
+        <div className="flex flex-col gap-2 md:flex-row">
+          <Input
+            placeholder="https://example.com/hooks/posts"
+            value={url}
+            onChange={(e) => setUrl(e.target.value)}
+          />
+          <select
+            className="rounded border px-2"
+            value={event}
+            onChange={(e) =>
+              setEvent(e.target.value as (typeof webhookEventValues)[number])
+            }
+          >
+            {webhookEventValues.map((value) => (
+              <option key={value} value={value}>
+                {value}
+              </option>
+            ))}
+          </select>
+          <Button
+            disabled={createMutation.isPending}
+            onClick={() => createMutation.mutate({ url, event })}
+          >
+            Add
+          </Button>
+        </div>
+        <ul className="flex flex-col gap-1">
+          {webhooks.data?.map((webhook) => (
+            <li
+              key={webhook.id.toString()}
+              className="flex items-center justify-between gap-2"
+            >
+              <span className="truncate text-sm">
+                {webhook.event} {webhook.url}
+              </span>
+              <Button
+                variant="outline"
+                onClick={() => removeMutation.mutate({ id: webhook.id })}
+              >
+                Remove
+              </Button>
+            </li>
+          ))}
+        </ul>
+      </CardContent>
+    </Card>
+  );
+}
