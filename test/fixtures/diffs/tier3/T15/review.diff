@@ -0,0 +1,27 @@
+import { removeWebhookInput, webhookInput } from '@shared/zod/webhook.js';
+
+import { StatusCode } from '@sc/utils/status-code.js';
+
+import { protectedProcedure, router } from '@apiv1/trpc/index.js';
+
+import { createWebhook, listWebhooks, removeWebhook } from './database.js';
+
+export const webhookRouter = router({
+  list: protectedProcedure.query(async (opts) => {
+    return await listWebhooks(opts.ctx.userId);
+  }),
+  create: protectedProcedure.input(webhookInput).mutation(async (opts) => {
+    const { url, event } = opts.input;
+
+    await createWebhook({ url, event, userId: opts.ctx.userId });
+    opts.ctx.res.status(StatusCode.CREATED);
+  }),
+  remove: protectedProcedure
+    .input(removeWebhookInput)
+    .mutation(async (opts) => {
+      const { id } = opts.input;
+
+      await removeWebhook({ id, userId: opts.ctx.userId });
+      opts.ctx.res.status(StatusCode.OK);
+    }),
+});
diff --git a/services/server/src/routes/v1/webhook/worker.ts b/services/server/src/routes/v1/webhook/worker.ts
new file mode 100644
index 0000000..d4aba6a
--- /dev/null
+++ b/services/server/src/routes/v1/webhook/worker.ts
@@ -0,0 +1,68 @@
+import { info } from '@sc/utils/logger.js';
+
+import { listPendingDeliveries, markDeliveryDelivered } from './database.js';
+
+const DELIVERY_INTERVAL_MS = 30_000;
+
+const deliverPending = async () => {
+  const pending = await listPendingDeliveries();
+
+  if (pending.length === 0) {
+    return;
+  }
+
+  await Promise.all(
+    pending.map(async (delivery) => {
+      // Mark the delivery as handled before the network call so a slow
+      // endpoint cannot cause the same event to be picked up twice.
+      await markDeliveryDelivered(delivery.id);
+
+      const payload = {
+        id: delivery.postId,
+        event: delivery.event,
+        title: delivery.title,
+        occurredAt: delivery.createdAt.toISOString(),
+      };
+
+      await fetch(delivery.webhook.url, {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          'x-webhook-secret': delivery.webhook.secret,
+        },
+        body: JSON.stringify(payload),
+      });
+    })
+  );
+
+  info(`Delivered ${pending.length} webhook event(s)`);
+};
+
+let timer: NodeJS.Timeout | undefined;
+let running = false;
+
+export const runDeliveryTick = async () => {
+  if (running) {
+    return;
+  }
+
+  running = true;
+  try {
+    await deliverPending();
+  } finally {
+    running = false;
+  }
+};
+
+export const startWebhookWorker = () => {
+  timer = setInterval(() => {
+    void runDeliveryTick();
+  }, DELIVERY_INTERVAL_MS);
+};
+
+export const stopWebhookWorker = () => {
+  if (timer) {
+    clearInterval(timer);
+    timer = undefined;
+  }
+};
diff --git a/services/shared/src/zod/webhook.ts b/services/shared/src/zod/webhook.ts
new file mode 100644
index 0000000..ac1e020
--- /dev/null
+++ b/services/shared/src/zod/webhook.ts
@@ -0,0 +1,22 @@
+import { z } from 'zod';
+
+import { type Protected, defaultId } from './common.js';
+
+export const webhookEventValues = [
+  'post.created',
+  'post.edited',
+  'post.removed',
+] as const;
+export const webhookEvent = z.enum(webhookEventValues);
+export type WebhookEvent = z.infer<typeof webhookEvent>;
+
+export const webhookInput = z.object({
+  url: z.string().url().max(500),
+  event: webhookEvent,
+});
+export type WebhookInput = z.infer<typeof webhookInput>;
+export type ProtectedWebhookInput = WebhookInput & Protected;
+
+export const removeWebhookInput = z.object({ id: defaultId });
+export type RemoveWebhookInput = z.infer<typeof removeWebhookInput>;
+export type ProtectedRemoveWebhookInput = RemoveWebhookInput & Protected;
