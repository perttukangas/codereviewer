diff --git a/services/client/src/pages/_components/Post/Search.tsx b/services/client/src/pages/_components/Post/Search.tsx
new file mode 100644
index 0000000..86f9c4f
--- /dev/null
+++ b/services/client/src/pages/_components/Post/Search.tsx
@@ -0,0 +1,32 @@
+import { useState } from 'react';
+
+import { Input } from '@cc/components/Input';
+
+interface SearchProps {
+  onSearch: (query: string) => void;
+}
+
+export default function Search({ onSearch }: SearchProps) {
+  const [query, setQuery] = useState('');
+
+  return (
+    <form
+      className="p-2"
+      onSubmit={(event) => {
+        event.preventDefault();
+        onSearch(query);
+      }}
+    >
+      <Input
+        type="search"
+        value={query}
+        placeholder="Search posts by title"
+        aria-label="Search posts by title"
+        onChange={(event) => setQuery(event.target.value)}
+      />
+      <p className="px-1 pt-1 text-xs text-muted-foreground">
+        Shows posts whose title contains the query.
+      </p>
+    </form>
+  );
+}
